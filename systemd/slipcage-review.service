[Unit]
Description=Slipcage bounded SQLite-backed metadata review (systemd-native)
After=local-fs.target

[Service]
Type=oneshot
User=isolab
Group=isolab
UMask=0077
ExecStart=/usr/local/bin/slipcage-guard run /usr/bin/python3 /opt/isolab/app/local_review.py --db /srv/isolab/research.sqlite3 --reports /srv/isolab/reports --max-reviews 3
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/isolab
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
MemoryAccounting=true
MemoryMax=512M
CPUAccounting=true
CPUQuota=100%
TasksMax=32
